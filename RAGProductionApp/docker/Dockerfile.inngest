# inngest's compose service used to run "npx --yes inngest-cli@latest",
# which does a full npm registry resolve + package download on EVERY
# container start (docker compose down/up recreates the container fresh
# every deploy — nothing persists to cache it). Verified live: on a slow
# network moment this took long enough that the container never opened
# its listening port within the health check's retry budget, failing an
# otherwise-healthy deploy and triggering a rollback. Same "don't depend
# on the network at deploy time" fix already applied to the Whisper model
# in docker/Dockerfile — bake the CLI in at image build time instead, so
# starting the container needs no network access at all.
FROM node:22-alpine

RUN npm install -g inngest-cli@1.44.0
