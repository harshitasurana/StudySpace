# =========================================
# APPLICATION CONFIG
# =========================================
INNGEST_APP_ID=rag-application
INNGEST_API_BASE=http://127.0.0.1:8288/v1
INNGEST_PRODUCTION=false

# =========================================
# OLLAMA CONFIG
# =========================================
# URL where local Ollama instance is running
OLLAMA_HOST=http://127.0.0.1:11434
# Model used for AI Tutor chat responses (core/tutor_engine.py)
TUTOR_CHAT_MODEL=llama3
# Used only when the chat request's subject is "Hindi"/"Gujarati" (a
# language subject, taught in that language) - always routed straight to
# Ollama, bypassing the cloud provider. Chosen via local evaluation.
TUTOR_CHAT_MODEL_HI=gemma3:4b
TUTOR_CHAT_MODEL_GU=gemma3:4b
# Model used for generating text embeddings (rag/data_loader.py)
TUTOR_EMBED_MODEL=bge-m3
# Help Center chatbot is a separate pipeline/vector collection — its own
# chat/embed models, independent of the AI Tutor pair above
HELP_CHAT_MODEL=qwen2.5vl:7b
HELP_EMBED_MODEL=bge-m3
# Context window size for Ollama inference (in tokens)
OLLAMA_NUM_CTX=4096
# Maximum tokens to predict/generate in response
OLLAMA_NUM_PREDICT=500
# Temperature for response generation (lower is more deterministic)
OLLAMA_TEMPERATURE=0.3

# =========================================
# QDRANT CONFIG
# =========================================
# URL where local or remote Qdrant instance is running
QDRANT_URL=http://127.0.0.1:6333
# Vector collection name in Qdrant
QDRANT_COLLECTION=docs
# Dimension of vector embeddings (768 for nomic-embed-text)
QDRANT_VECTOR_DIM=768
# Timeout in seconds for Qdrant client requests
QDRANT_TIMEOUT=30

# =========================================
# RAG CONFIG
# =========================================
# Number of relevant document chunks to retrieve
RAG_TOP_K=5
# Maximum characters of context to pass to the LLM prompt
RAG_CONTEXT_MAX_CHARS=6000
# Text chunk size (in characters) when parsing documents
CHUNK_SIZE=1000
# Text chunk overlap (in characters) to maintain context
CHUNK_OVERLAP=200

# =========================================
# FILE STORAGE CONFIG
# =========================================
# Local-disk storage (core/local_image_storage.py) — the only storage
# backend in this deployment, no MinIO/S3 or any other remote object
# store involved at all.
LOCAL_MEDIA_ROOT=local_media

# Directory where uploaded documents/PDFs are stored
UPLOADS_DIR=uploads
# File paths for chat histories and student progress memory
STUDENT_MEMORY_FILE=data/student_memory.json
CHAT_HISTORY_FILE=data/chat_history.json
DEFAULT_QUIZ_QUESTIONS=10

# =========================================
# NODE BACKEND (callbacks + auth)
# =========================================
# The real Node backend's own base URL — every Celery task's
# progress/completion callback posts here, and it's this service's CORS
# allow-origin. No default in code; required.
NODE_BACKEND_ORIGIN=http://localhost:3000
# Shared secret with the Node backend's AI_SERVICE_KEY — required for
# every authenticated call from Node to succeed (verify_service_key()).
AI_SERVICE_KEY=

# =========================================
# CELERY / REDIS
# =========================================
REDIS_URL=redis://localhost:6379/0
