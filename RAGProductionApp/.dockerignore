# Mirrors .gitignore's spirit for the same reasons (dev tooling, secrets,
# caches, runtime-generated state) — this file never existed before, so
# every build was previously sending the ENTIRE repo as build context,
# including .venv (a multi-GB, platform-specific virtualenv that has no
# business inside an image pip installs its own deps into anyway).

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
ENV/

# Environment / secrets — injected at deploy time via compose's env_file,
# never baked into the image.
.env
.env.*
!.env.example

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# Testing / cache
.pytest_cache/
.cache/
.coverage
htmlcov/
.mypy_cache/
tests/

# Logs
*.log

# Runtime data — mounted as volumes in every compose file
# (../data:/app/data, ../uploads:/app/uploads), not baked in.
data/
uploads/
local_media/

# Qdrant local storage (this app connects to an external Qdrant, doesn't
# run its own).
qdrant_storage/

# Git
.git/
.gitignore

# Node (streamlit_app.py's own tooling, if any — no Node runtime code
# ships in this image)
node_modules/

# Build outputs
dist/
build/
.vite/

# Local generated / temp files
*.tmp
*.temp
*.bak

# sample_paper/ is ingestion-only source material (unlike knowledge_base/,
# NCERT-Notes/, NCERT-Solutions/ — verified those ARE live runtime
# dependencies: GET /api/chapters/pdf and /api/chapters/ncert-*-pdf stream
# these exact files straight to the chapter reader on every real request,
# so they must stay in the image; almost excluded them by wrongly
# assuming all four were offline-only like .gitignore's grouping suggests).
sample_paper/

# NOTE: voice_models/*.onnx is deliberately NOT excluded here even though
# *.onnx is gitignored — the Piper TTS voice model is a real runtime
# dependency (core/tts_service.py loads it at import time), not a dev
# artifact. Since it's gitignored, a real CI build (checkout from git, no
# access to this machine's local files) needs the Dockerfile to fetch it
# itself — see the Dockerfile's own model-download step.
