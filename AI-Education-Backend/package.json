  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "nodemon src/server.js",
    "build": "echo Build not required for Node runtime",
    "release": "standard-version",
    "release:rc": "standard-version --prerelease rc",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "generateDoc": "node src/swagger.js",
    "generate:frontend": "node scripts/generate-frontend-angular-scaffold.js",
    "generate:frontend:dry": "node scripts/generate-frontend-angular-scaffold.js --dry-run",
    "generate:frontend:force": "node scripts/generate-frontend-angular-scaffold.js --force",
    "generate:frontend:services": "node scripts/generate-frontend-angular-scaffold.js --force-services",
    "generate:frontend:models": "node scripts/generate-frontend-angular-scaffold.js --force-models",
    "generate:frontend:legacy": "node scripts/generate-frontend-angular-scaffold.js --legacy-endpoints",
    "generate:frontend:create-missing": "node scripts/generate-frontend-angular-scaffold.js --create-missing",
    "generate:frontend:sync": "node scripts/generate-frontend-angular-scaffold.js --create-missing --force-services --force-models",
    "db:seed": "node scripts/seed-db.js",
    "db:migrate": "node scripts/run-migrations.js",
    "db:sync": "node scripts/sync-db.js"
  },
