# Required at BUILD time — Vite only inlines VITE_* vars that exist when
# `vite build` runs, so this must be present as .env.<mode> in the Docker
# build context BEFORE the image is built, not just set as a container
# runtime env var. See apiClient.js — a production build with this
# missing fails loudly on load rather than silently defaulting to
# localhost.
#
# Real deploys use a namespaced mode (frontend.dev/frontend.integration/
# frontend.preprod/frontend.prod — see compose/*.yml's VITE_MODE build
# arg and the Jenkinsfile), so Jenkins writes this to .env.frontend.dev
# etc, NOT the generic .env.development/.env.production Vite defaults
# to for a bare `npm run dev`/`npm run build` — deliberately, so this
# project's deployed env file is never confused with an unrelated
# project's identically-named one when scanning Jenkins credentials.
VITE_API_URL=http://localhost:3000

